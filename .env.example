# Environment variables for Clockify Utils
# Copy this file to .env and fill in your values

CLOCKIFY_API_KEY=your-api-key-here

# Optional: read the key from a file that contains only the key
# (used when CLOCKIFY_API_KEY is not set)
# CLOCKIFY_API_KEY_FILE=~/.config/clockify/api-key

# Optional: workspace ID (otherwise taken from the prefs file, config.yaml,
# or the only workspace the key can see)
# CLOCKIFY_WORKSPACE_ID=your-workspace-id-here

# Optional: timezone for log, entries, report and gaps (IANA name)
# CLOCKIFY_TZ=America/Argentina/Buenos_Aires

# Optional: fixed UTC offset in hours, used when CLOCKIFY_TZ is not set and the
# prefs file has no timezone.offset
# CLOCKIFY_TZ_OFFSET=-3
